rules_version='2'

service cloud.firestore {
  match /databases/{database}/documents {
    match /evidence_records/{evidenceId} {
      allow read, create: if request.time < timestamp.date(2026, 9, 22);
      allow update, delete: if request.time < timestamp.date(2026, 9, 22)
        && !exists(/databases/$(database)/documents/evidence_anchors/$(evidenceId));
    }

    match /evidence_anchors/{evidenceId} {
      allow read, create: if request.time < timestamp.date(2026, 9, 22);
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read: if request.time < timestamp.date(2026, 9, 22);
      allow create: if request.time < timestamp.date(2026, 9, 22)
        && request.resource.__name__.segments[0] != 'evidence_records'
        && request.resource.__name__.segments[0] != 'evidence_anchors';
      allow update, delete: if request.time < timestamp.date(2026, 9, 22)
        && resource.__name__.segments[0] != 'evidence_records'
        && resource.__name__.segments[0] != 'evidence_anchors';
    }
  }
}
