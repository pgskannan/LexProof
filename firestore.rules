rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsEvidence(evidenceId) {
      return signedIn()
        && get(/databases/$(database)/documents/evidence_records/$(evidenceId)).data.owner_id
          == request.auth.uid;
    }

    match /evidence_records/{evidenceId} {
      allow create: if signedIn()
        && request.resource.data.owner_id == request.auth.uid;
      allow read: if signedIn()
        && resource.data.owner_id == request.auth.uid;
      allow update: if signedIn()
        && resource.data.owner_id == request.auth.uid
        && request.resource.data.owner_id == resource.data.owner_id
        && !exists(/databases/$(database)/documents/evidence_anchors/$(evidenceId));
      allow delete: if signedIn()
        && resource.data.owner_id == request.auth.uid
        && !exists(/databases/$(database)/documents/evidence_anchors/$(evidenceId));
    }

    match /evidence_anchors/{evidenceId} {
      allow create: if ownsEvidence(evidenceId)
        && request.resource.data.evidence_id == evidenceId;
      allow read: if ownsEvidence(evidenceId);
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
