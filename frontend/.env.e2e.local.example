# Phase 3J-A: copy this file to frontend/.env.e2e.local (already git-ignored)
# and fill in real values for a LexProof user that already exists in the
# real lexproof-afc7c Firebase project and the real backend. Never commit
# real credentials -- this file only exists as a template.

# Local frontend dev server. Must stay localhost/127.0.0.1 unless you pass
# E2E_ALLOW_REMOTE=true explicitly (see playwright.config.ts) -- LexProof has
# no separate E2E/staging environment today.
E2E_BASE_URL=http://localhost:3000

# A real, already-provisioned LexProof user (email/password sign-in).
# Do NOT use a real customer account -- use a dedicated test user.
E2E_USER_EMAIL=
E2E_USER_PASSWORD=

# Golden-path / negative-security / full-lifecycle workflow identities.
# These must be the real Firebase Email/Password users for demo-owner-1,
# demo-reviewer-1, and demo-approver-1 -- never the admin account.
E2E_OWNER_EMAIL=
E2E_OWNER_PASSWORD=
E2E_REVIEWER_EMAIL=
E2E_REVIEWER_PASSWORD=
E2E_APPROVER_EMAIL=
E2E_APPROVER_PASSWORD=

# Full-lifecycle audit-trail step only. The /dashboard/admin/audit-log page
# is gated to admin/auditor (demo-admin-1). Required by
# e2e/workflow/full-lifecycle-real-upload.spec.ts.
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=

# Cross-tenant isolation test (Phase 2 of the "close remaining E2E security
# gaps" follow-up). Real Firebase Email/Password users for a genuinely
# separate second org's owner/reviewer -- demo-tenant-b-owner-1 and
# demo-tenant-b-reviewer-1. Provision via
# backend/scripts/provision_e2e_security_identities.py after seeding
# backend/scripts/create_approval_demo_fixture.py --fixture cross-tenant-isolation.
E2E_TENANT_B_OWNER_EMAIL=
E2E_TENANT_B_OWNER_PASSWORD=
E2E_TENANT_B_REVIEWER_EMAIL=
E2E_TENANT_B_REVIEWER_PASSWORD=

# Dual-role separation-of-duty test (Phase 3 of the same follow-up). Real
# Firebase Email/Password user for demo-dual-role-1, who holds BOTH
# contract_owner and reviewer in the lexproof-demo org. Provision via the
# same script, after seeding --fixture dual-role-sod.
E2E_DUAL_ROLE_EMAIL=
E2E_DUAL_ROLE_PASSWORD=
